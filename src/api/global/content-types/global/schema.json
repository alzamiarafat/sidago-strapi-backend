{
  "kind": "singleType",
  "collectionName": "globals",
  "info": {
    "singularName": "global",
    "pluralName": "globals",
    "displayName": "Global",
    "description": "Global website settings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "required": true,
      "default": "Sidago"
    },
    "siteContactEmail": {
      "type": "email",
      "required": true
    },
    "siteLogo": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "version": {
      "type": "component",
      "repeatable": false,
      "component": "shared.site-version"
    },
    "footer": {
      "type": "component",
      "repeatable": false,
      "component": "shared.footer"
    }
  }
}
